# Use the SAME Supabase project as the Journey Creator web app.
# These values are bundled into the client. Only public credentials belong here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me


# Public Mapbox client token only (pk.). Native development build required.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Existing public web deployment, used for canonical native sharing.
EXPO_PUBLIC_SITE_URL=https://www.journeycreator.site
